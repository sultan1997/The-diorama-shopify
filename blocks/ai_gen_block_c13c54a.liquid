{% doc %}
  @prompt
    video on one side and 3 title text blocks on the other side of column
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-text-columns-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-video-text-columns__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.column_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
  }

  .ai-video-text-columns__video-column-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-video-text-columns__text-column-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_block_gap }}px;
  }

  .ai-video-text-columns__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-text-columns__video-wrapper-{{ ai_gen_id }} iframe,
  .ai-video-text-columns__video-wrapper-{{ ai_gen_id }} video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-text-columns__video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-video-text-columns__video-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-video-text-columns__text-block-{{ ai_gen_id }} {
    padding: {{ block.settings.text_block_padding }}px;
    background-color: {{ block.settings.text_block_bg_color }};
    border-radius: {{ block.settings.text_block_border_radius }}px;
  }

  .ai-video-text-columns__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
  }

  .ai-video-text-columns__text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_font_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-video-text-columns__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-video-text-columns__video-column-{{ ai_gen_id }} {
      {% if block.settings.mobile_video_position == 'bottom' %}
        order: 2;
      {% endif %}
    }

    .ai-video-text-columns__text-column-{{ ai_gen_id }} {
      {% if block.settings.mobile_video_position == 'bottom' %}
        order: 1;
      {% endif %}
    }
  }
{% endstyle %}

<video-text-columns-{{ ai_gen_id }}
  class="ai-video-text-columns-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-text-columns__container-{{ ai_gen_id }}">
    <div class="ai-video-text-columns__video-column-{{ ai_gen_id }}">
      <div class="ai-video-text-columns__video-wrapper-{{ ai_gen_id }}">
        {% if block.settings.video_url != blank %}
          {% if block.settings.video_url contains 'youtube.com' or block.settings.video_url contains 'youtu.be' %}
            {% assign video_id = block.settings.video_url | split: 'v=' | last | split: '/' | last | split: '&' | first %}
            <iframe
              src="https://www.youtube.com/embed/{{ video_id }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {% elsif block.settings.video_url contains 'vimeo.com' %}
            {% assign video_id = block.settings.video_url | split: '/' | last %}
            <iframe
              src="https://player.vimeo.com/video/{{ video_id }}"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {% else %}
            <video controls>
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
          {% endif %}
        {% else %}
          <div class="ai-video-text-columns__video-placeholder-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-video-text-columns__text-column-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign title_key = 'title_' | append: i
          assign text_key = 'text_' | append: i
          assign title = block.settings[title_key]
          assign text = block.settings[text_key]
        %}

        {% if title != blank or text != blank %}
          <div class="ai-video-text-columns__text-block-{{ ai_gen_id }}">
            {% if title != blank %}
              <h3 class="ai-video-text-columns__title-{{ ai_gen_id }}">{{ title }}</h3>
            {% endif %}
            {% if text != blank %}
              <div class="ai-video-text-columns__text-{{ ai_gen_id }}">{{ text }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</video-text-columns-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoTextColumns{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('video-text-columns-{{ ai_gen_id }}', VideoTextColumns{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Video with text blocks",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL"
    },
    {
      "type": "range",
      "id": "video_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Video border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text blocks"
    },
    {
      "type": "inline_richtext",
      "id": "title_1",
      "label": "Title 1",
      "default": "Feature one"
    },
    {
      "type": "richtext",
      "id": "text_1",
      "label": "Text 1",
      "default": "<p>Describe your first feature here with compelling details.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "title_2",
      "label": "Title 2",
      "default": "Feature two"
    },
    {
      "type": "richtext",
      "id": "text_2",
      "label": "Text 2",
      "default": "<p>Describe your second feature here with compelling details.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "title_3",
      "label": "Title 3",
      "default": "Feature three"
    },
    {
      "type": "richtext",
      "id": "text_3",
      "label": "Text 3",
      "default": "<p>Describe your third feature here with compelling details.</p>"
    },
    {
      "type": "header",
      "content": "Text block style"
    },
    {
      "type": "range",
      "id": "text_block_padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_block_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "text_block_bg_color",
      "label": "Background color",
      "default": "#f3f3f3"
    },
    {
      "type": "range",
      "id": "text_block_gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap between blocks",
      "default": 16
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 20
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Title spacing",
      "default": 8
    },
    {
      "type": "range",
      "id": "text_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 16,
      "max": 80,
      "step": 8,
      "unit": "px",
      "label": "Column gap",
      "default": 40
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_video_position",
      "label": "Video position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 16,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Video with text blocks"
    }
  ]
}
{% endschema %}
