</div>

<script>
(function(){
  function init(hero){
    var track = hero.querySelector('.hero-track');
    var dots = hero.querySelector('.hero-dots');
    if(!track || !dots) return;
    var btns = dots.querySelectorAll('button');
    if(!btns.length) return;
    function to(idx){ idx = Math.max(0, Math.min(btns.length - 1, idx)); track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' }); }
    function current(){ return Math.round(track.scrollLeft / track.clientWidth); }
    btns.forEach(function(b,i){ b.addEventListener('click', function(){ to(i); }); });
    var prev = hero.querySelector('.hero-prev'), next = hero.querySelector('.hero-next');
    if(prev) prev.addEventListener('click', function(){ var i = current() - 1; if(i < 0) i = btns.length - 1; to(i); });
    if(next) next.addEventListener('click', function(){ var i = current() + 1; if(i > btns.length - 1) i = 0; to(i); });
    var raf;
    track.addEventListener('scroll', function(){
      if(raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function(){
        var idx = Math.max(0, Math.min(btns.length - 1, current()));
        btns.forEach(function(b,i){ b.setAttribute('aria-current', i === idx ? 'true' : 'false'); });
      });
    }, { passive: true });
  }
  function boot(){ document.querySelectorAll('.dh .hero').forEach(init); }
  if(document.readyState !== 'loading'){ boot(); } else { document.addEventListener('DOMContentLoaded', boot); }
})();
</script>

