      <div class="rev-grid">
        <div class="rev"><span class="s">★★★★★</span><p class="q">{{ section.settings.rev1_q }}</p><div class="who"><span class="av">{{ section.settings.rev1_n | slice: 0 | upcase }}</span><div><div class="nm">{{ section.settings.rev1_n }}</div><div class="ro">{{ section.settings.rev1_r }}</div></div></div></div>
        <div class="rev"><span class="s">★★★★★</span><p class="q">{{ section.settings.rev2_q }}</p><div class="who"><span class="av">{{ section.settings.rev2_n | slice: 0 | upcase }}</span><div><div class="nm">{{ section.settings.rev2_n }}</div><div class="ro">{{ section.settings.rev2_r }}</div></div></div></div>
        <div class="rev"><span class="s">★★★★★</span><p class="q">{{ section.settings.rev3_q }}</p><div class="who"><span class="av">{{ section.settings.rev3_n | slice: 0 | upcase }}</span><div><div class="nm">{{ section.settings.rev3_n }}</div><div class="ro">{{ section.settings.rev3_r }}</div></div></div></div>
