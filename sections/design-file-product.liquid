{% comment %}The Diorama, 3D Design File Product Page · blueprint/technical layout{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>
<style>
  .dfp{
    --bg:#F6F6F7; --paper:#FFFFFF; --ink:#2B2B2E; --ink-2:#5C5C66; --ink-3:#9C9CA3;
    --rule:#E5E5E5; --rule-2:#D6D6DA; --hairline:#ECECEE;
    --blueprint:#3A13FF; --blueprint-deep:#2A0FBE; --blueprint-bg:#EFEBFF; --warn:#B05A3E;
    --display:"Raleway","Helvetica Neue",Helvetica,Arial,sans-serif;
    --sans:"Roboto","Helvetica Neue",Helvetica,Arial,sans-serif;
    --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    background:var(--bg); color:var(--ink); font-family:var(--sans); font-size:14.5px; line-height:1.55;
  }
  .dfp *{box-sizing:border-box;}
  .dfp a{color:inherit;text-decoration:none;}
  .dfp button{font-family:inherit;cursor:pointer;}
  .dfp img{display:block;max-width:100%;}
  .dfp .mono{font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3);}
  .dfp .display{font-family:var(--display);font-weight:500;letter-spacing:-.02em;}
  .dfp .container{max-width:1320px;margin:0 auto;padding:0 32px;}

  /* announce */
  .dfp .announce{background:var(--ink);color:#D7DAE0;font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;text-align:center;padding:9px 0;}
  .dfp .announce .dot{color:var(--blueprint);margin:0 14px;}

  /* breadcrumb */
  .dfp .crumbs{padding:20px 0 6px;font-size:12px;color:var(--ink-3);display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
  .dfp .crumbs .sep{color:var(--rule-2);}
  .dfp .crumbs .here{color:var(--ink);}

  /* hero */
  .dfp .hero{padding:14px 0 64px;}
  .dfp .hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);gap:48px;align-items:start;}

  /* viewer */
  .dfp .viewer{background:var(--paper);border:1px solid var(--rule);border-radius:10px;position:relative;overflow:hidden;aspect-ratio:4/3;}
  .dfp .viewer .grid-bg{position:absolute;inset:0;background:linear-gradient(var(--hairline) 1px,transparent 1px) 0 0/24px 24px,linear-gradient(90deg,var(--hairline) 1px,transparent 1px) 0 0/24px 24px,radial-gradient(ellipse 60% 50% at 50% 55%,#F2F2F3 0%,#F6F6F7 70%);}
  .dfp .viewer .stage{position:absolute;inset:0;display:grid;place-items:center;padding:40px;}
  .dfp .viewer .stage img{width:100%;height:100%;object-fit:contain;}
  .dfp .viewer .ph{color:var(--rule-2);}
  .dfp .viewer-toolbar{position:absolute;top:14px;left:14px;display:flex;gap:6px;background:rgba(255,255,255,.95);border:1px solid var(--rule);border-radius:8px;padding:4px;z-index:2;}
  .dfp .vt-btn{background:transparent;border:0;padding:7px 10px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-2);border-radius:5px;}
  .dfp .vt-btn[data-active="true"]{background:var(--ink);color:var(--bg);}
  .dfp .vt-btn:hover:not([data-active="true"]){background:var(--hairline);}
  .dfp .viewer-info{position:absolute;top:14px;right:14px;background:rgba(255,255,255,.95);border:1px solid var(--rule);border-radius:8px;padding:8px 12px;font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-2);display:flex;gap:14px;align-items:center;z-index:2;}
  .dfp .viewer-info .live{display:inline-flex;align-items:center;gap:6px;}
  .dfp .viewer-info .live::before{content:"";width:6px;height:6px;border-radius:999px;background:var(--blueprint);}
  .dfp .viewer-controls{position:absolute;bottom:14px;left:14px;right:14px;display:flex;justify-content:space-between;align-items:center;z-index:2;}
  .dfp .dfp-nav{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.95);border:1px solid var(--rule);display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:4;box-shadow:0 1px 7px rgba(0,0,0,.12);transition:background .15s,box-shadow .15s;padding:0;}
  .dfp .dfp-nav:hover{background:#fff;box-shadow:0 3px 12px rgba(0,0,0,.2);}
  .dfp .dfp-nav svg{width:16px;height:16px;stroke:#1f1f1f;stroke-width:1.8;fill:none;}
  .dfp .dfp-nav-prev{left:12px;}.dfp .dfp-nav-next{right:12px;}
  @media(max-width:600px){.dfp .dfp-nav{width:34px;height:34px;}.dfp .dfp-nav svg{width:14px;height:14px;}}
  .dfp .vc-axes{display:flex;gap:4px;background:rgba(255,255,255,.95);border:1px solid var(--rule);border-radius:8px;padding:4px;}
  .dfp .vc-axes button{min-width:42px;height:32px;padding:0 6px;background:transparent;border:0;font-family:var(--mono);font-size:10px;color:var(--ink-2);border-radius:4px;}
  .dfp .vc-axes button[data-active="true"]{background:var(--blueprint-bg);color:var(--blueprint-deep);}
  .dfp .vc-axes button:hover:not([data-active="true"]){background:var(--hairline);}
  .dfp .vc-actions{display:flex;gap:6px;}
  .dfp .vc-actions button{background:rgba(255,255,255,.95);border:1px solid var(--rule);border-radius:8px;padding:8px;color:var(--ink-2);display:grid;place-items:center;}
  .dfp .vc-actions button:hover{color:var(--ink);border-color:var(--ink-2);}

  /* thumb rail */
  .dfp .thumb-rail{display:grid;grid-template-columns:repeat(auto-fill,minmax(72px,1fr));gap:10px;margin-top:12px;}
  .dfp .vt{background:var(--paper);border:1px solid var(--rule);border-radius:6px;aspect-ratio:1;position:relative;overflow:hidden;padding:0;}
  .dfp .vt[data-active="true"]{border-color:var(--ink);}
  .dfp .vt:hover{border-color:var(--ink-2);}
  .dfp .vt .vt-bg{position:absolute;inset:0;background:linear-gradient(var(--hairline) 1px,transparent 1px) 0 0/12px 12px,linear-gradient(90deg,var(--hairline) 1px,transparent 1px) 0 0/12px 12px,#F6F6F7;}
  .dfp .vt img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .dfp .vt .vt-label{position:absolute;left:6px;bottom:6px;font-family:var(--mono);font-size:9px;letter-spacing:.1em;color:var(--ink-3);text-transform:uppercase;z-index:2;}

  /* buy box */
  .dfp .designer-row{display:flex;align-items:center;gap:12px;font-size:13px;color:var(--ink-2);flex-wrap:wrap;}
  .dfp .designer-row .ava{width:28px;height:28px;border-radius:999px;background:var(--blueprint-bg);color:var(--blueprint-deep);display:grid;place-items:center;font-family:var(--display);font-weight:600;font-size:13px;}
  .dfp .designer-row .verified{font-family:var(--mono);font-size:10px;letter-spacing:.08em;color:var(--blueprint-deep);background:var(--blueprint-bg);padding:3px 7px;border-radius:4px;text-transform:uppercase;}
  .dfp h1.title{font-family:var(--display);font-weight:600;font-size:44px;line-height:1.04;letter-spacing:-.02em;margin:12px 0 6px;}
  .dfp .subtitle{color:var(--ink-2);font-size:15px;max-width:48ch;}
  .dfp .stat-row{display:flex;gap:24px;margin-top:16px;align-items:center;flex-wrap:wrap;}
  .dfp .stat-row .stars-inner{letter-spacing:1px;color:var(--blueprint);font-size:13px;}
  .dfp .stat-row .sep{width:1px;height:14px;background:var(--rule);}
  .dfp .stat-row .stat{font-family:var(--mono);font-size:11px;color:var(--ink-3);letter-spacing:.06em;text-transform:uppercase;}
  .dfp .stat-row .stat strong{color:var(--ink);font-weight:500;}
  .dfp .usp-badges{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px;}
  .dfp .usp-badge{background:var(--blueprint-bg);border:1px solid #DCD3FF;border-radius:8px;padding:12px 12px 12px 14px;display:flex;align-items:flex-start;gap:10px;}
  .dfp .usp-badge .ico{color:var(--blueprint-deep);flex:0 0 auto;margin-top:1px;}
  .dfp .usp-badge .ttl{font-family:var(--display);font-weight:600;font-size:13px;color:var(--ink);letter-spacing:-.005em;}
  .dfp .usp-badge .sub{font-family:var(--mono);font-size:10px;letter-spacing:.06em;color:var(--blueprint-deep);text-transform:uppercase;margin-top:2px;}
  .dfp .field{margin-top:24px;}
  .dfp .field-label{display:flex;justify-content:space-between;align-items:baseline;font-size:12px;color:var(--ink-3);font-family:var(--mono);letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px;gap:12px;}
  .dfp .field-label .pick{color:var(--ink);font-family:var(--display);font-weight:500;font-size:16px;text-transform:none;letter-spacing:-.01em;}
  .dfp .usage-note{font-size:13px;color:var(--ink-2);line-height:1.55;max-width:52ch;}
  .dfp .formats{display:flex;flex-wrap:wrap;gap:6px;}
  .dfp .fmt{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);border:1px solid var(--rule);padding:4px 8px;border-radius:4px;background:var(--paper);}
  .dfp .fmt.printable{border-color:#D8D0F4;color:var(--blueprint-deep);background:var(--blueprint-bg);}
  .dfp .fmt.laser{border-color:#DDE4D2;color:#3F5C1C;background:#EFF4E2;}
  .dfp .fmt.cnc{border-color:#E6D8C4;color:#6E4A14;background:#F6EEDD;}
  .dfp .fmt.source{border-color:var(--rule);color:var(--ink-2);}
  .dfp .price-row{display:flex;align-items:baseline;gap:10px;margin-top:22px;}
  .dfp .price{font-family:var(--display);font-weight:600;font-size:30px;letter-spacing:-.02em;color:var(--ink);}
  .dfp .price-compare{font-size:17px;color:var(--ink-3);text-decoration:line-through;}
  .dfp .cta-row{display:grid;grid-template-columns:1fr;gap:8px;margin-top:16px;}
  .dfp .cta{height:50px;border-radius:8px;border:0;background:var(--ink);color:#fff;font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;display:inline-flex;align-items:center;justify-content:center;gap:10px;transition:background .15s ease;width:100%;}
  .dfp .cta:hover{background:#000;}
  .dfp .cta.blueprint{background:var(--blueprint);}
  .dfp .cta.blueprint:hover{background:var(--blueprint-deep);}
  .dfp .cta[disabled]{background:var(--ink-3);cursor:not-allowed;}
  .dfp .meta-line{font-size:12px;color:var(--ink-3);margin-top:10px;}
  .dfp .quickfacts{margin-top:24px;border-top:1px solid var(--hairline);}
  .dfp .qf{display:grid;grid-template-columns:140px 1fr;padding:10px 0;border-bottom:1px solid var(--hairline);font-size:13px;}
  .dfp .qf .k{color:var(--ink-3);font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;padding-top:2px;}
  .dfp .qf .v{color:var(--ink);}

  /* section */
  .dfp .section{padding:96px 0;border-top:1px solid var(--rule);}
  .dfp .sec-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:56px;align-items:end;margin-bottom:48px;}
  .dfp .sec-head h2{font-family:var(--display);font-weight:600;font-size:52px;line-height:1;letter-spacing:-.025em;margin:12px 0 0;}
  .dfp .sec-head .lede{color:var(--ink-2);font-size:17px;max-width:58ch;}

  /* usp showcase */
  .dfp .usp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .dfp .usp{background:var(--paper);border:1px solid var(--rule);border-radius:10px;padding:28px;display:flex;flex-direction:column;min-height:380px;}
  .dfp .usp .num{font-family:var(--mono);font-size:11px;color:var(--ink-3);letter-spacing:.12em;}
  .dfp .usp .ico-wrap{width:48px;height:48px;border-radius:8px;display:grid;place-items:center;margin:18px 0 22px;background:var(--blueprint-bg);color:var(--blueprint-deep);}
  .dfp .usp.laser .ico-wrap{background:#EFF4E2;color:#3F5C1C;}
  .dfp .usp.cnc .ico-wrap{background:#F6EEDD;color:#6E4A14;}
  .dfp .usp h3{font-family:var(--display);font-weight:600;font-size:26px;line-height:1.1;letter-spacing:-.015em;margin:0 0 10px;}
  .dfp .usp p{color:var(--ink-2);font-size:14px;margin:0 0 22px;}
  .dfp .usp .check-list{list-style:none;padding:18px 0 0;margin:auto 0 0;display:grid;gap:8px;border-top:1px solid var(--hairline);}
  .dfp .usp .check-list li{display:grid;grid-template-columns:16px 1fr;gap:10px;align-items:baseline;font-size:13px;color:var(--ink);}
  .dfp .usp .check-list .c{color:var(--blueprint);margin-top:1px;}

  /* geometry stats */
  .dfp .geom-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);}
  .dfp .geom-cell{padding:32px;border-right:1px solid var(--rule);}
  .dfp .geom-cell:nth-child(4n){border-right:0;}
  .dfp .geom-cell .k{font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);}
  .dfp .geom-cell .v{font-family:var(--display);font-weight:600;font-size:40px;letter-spacing:-.02em;margin-top:10px;line-height:1;}
  .dfp .geom-cell .s{font-size:12px;color:var(--ink-3);margin-top:6px;}

  /* manifest */
  .dfp .manifest{background:var(--paper);border:1px solid var(--rule);border-radius:10px;overflow:hidden;}
  .dfp .manifest-head,.dfp .manifest-row{display:grid;grid-template-columns:80px 1fr 100px 120px 140px;padding:14px 22px;align-items:center;}
  .dfp .manifest-head{background:#F1F1F0;border-bottom:1px solid var(--rule);font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--ink-3);text-transform:uppercase;}
  .dfp .manifest-row{border-bottom:1px solid var(--hairline);font-size:13px;}
  .dfp .manifest-row:last-child{border-bottom:0;}
  .dfp .manifest-row .ext{font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;padding:4px 8px;border-radius:4px;display:inline-block;font-weight:500;}
  .dfp .ext.printable{background:var(--blueprint-bg);color:var(--blueprint-deep);}
  .dfp .ext.laser{background:#EFF4E2;color:#3F5C1C;}
  .dfp .ext.cnc{background:#F6EEDD;color:#6E4A14;}
  .dfp .ext.source{background:var(--hairline);color:var(--ink);}
  .dfp .ext.doc{background:#F2EAF7;color:#5A2E7A;}
  .dfp .manifest-row .nm{font-family:var(--mono);font-size:13px;color:var(--ink);}
  .dfp .manifest-row .size,.dfp .manifest-row .ct{color:var(--ink-2);font-family:var(--mono);font-size:12px;}
  .dfp .manifest-row .purpose{color:var(--ink-2);font-size:12px;}
  .dfp .manifest-foot{padding:14px 22px;background:#FAFAFA;border-top:1px solid var(--rule);display:flex;justify-content:space-between;align-items:center;gap:12px;font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-2);flex-wrap:wrap;}

  /* benefits */
  .dfp .benefit-time{display:grid;grid-template-columns:1fr auto 1fr;align-items:stretch;border:1px solid var(--rule);border-radius:10px;overflow:hidden;margin-bottom:28px;}
  .dfp .bt-cell{padding:32px 36px;background:var(--paper);}
  .dfp .bt-cell.highlight{background:var(--blueprint-bg);border-left:1px solid #DCD3FF;}
  .dfp .bt-cell .k{font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);}
  .dfp .bt-cell.highlight .k{color:var(--blueprint-deep);}
  .dfp .bt-cell .v{font-family:var(--display);font-weight:600;font-size:48px;line-height:1;letter-spacing:-.025em;margin:12px 0;}
  .dfp .bt-cell.highlight .v{color:var(--blueprint-deep);}
  .dfp .bt-cell .s{font-size:14px;color:var(--ink-2);max-width:36ch;}
  .dfp .bt-arrow{display:grid;place-items:center;padding:0 18px;color:var(--ink-3);background:var(--paper);}
  .dfp .benefit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .dfp .benefit{background:var(--paper);border:1px solid var(--rule);border-radius:10px;padding:28px;}
  .dfp .benefit .ico-wrap{width:48px;height:48px;border-radius:8px;display:grid;place-items:center;background:var(--blueprint-bg);color:var(--blueprint-deep);margin-bottom:20px;}
  .dfp .benefit h3{font-family:var(--display);font-weight:600;font-size:24px;line-height:1.1;letter-spacing:-.015em;margin:0 0 10px;}
  .dfp .benefit p{color:var(--ink-2);font-size:14px;margin:0;}

  /* compat */
  .dfp .compat-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;}
  .dfp .compat{background:var(--paper);border:1px solid var(--rule);border-radius:8px;padding:20px 16px;text-align:center;}
  .dfp .compat .glyph-box{width:40px;height:40px;margin:0 auto;display:grid;place-items:center;border-radius:8px;background:var(--hairline);color:var(--ink);font-family:var(--display);font-weight:600;font-size:16px;}
  .dfp .compat .app{font-family:var(--display);font-weight:500;font-size:15px;margin-top:12px;letter-spacing:-.005em;}
  .dfp .compat .ver{font-family:var(--mono);font-size:10px;color:var(--ink-3);letter-spacing:.06em;margin-top:4px;text-transform:uppercase;}

  /* faq */
  .dfp .faq{border-top:1px solid var(--rule);}
  .dfp .faq-item{border-bottom:1px solid var(--rule);}
  .dfp .faq-q{width:100%;text-align:left;background:transparent;border:0;padding:26px 0;display:grid;grid-template-columns:60px 1fr 32px;gap:18px;align-items:baseline;color:var(--ink);}
  .dfp .faq-q .ix{font-family:var(--mono);font-size:11px;color:var(--ink-3);letter-spacing:.1em;padding-top:6px;}
  .dfp .faq-q .q{font-family:var(--display);font-weight:600;font-size:22px;line-height:1.25;letter-spacing:-.01em;}
  .dfp .faq-q .toggle{font-family:var(--display);font-weight:500;font-size:22px;color:var(--ink-2);text-align:right;}
  .dfp .faq-a{display:none;grid-template-columns:60px 1fr 32px;gap:18px;padding:0 0 26px;}
  .dfp .faq-item.open .faq-a{display:grid;}
  .dfp .faq-a .ans{color:var(--ink-2);font-size:15px;max-width:64ch;grid-column:2;white-space:pre-line;}

  /* reviews */
  .dfp .reviews{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,2fr);gap:56px;}
  .dfp .review-sum .big{font-family:var(--display);font-weight:600;font-size:88px;line-height:1;letter-spacing:-.03em;}
  .dfp .review-sum .of{color:var(--ink-3);font-size:13px;margin-top:6px;}
  .dfp .bars{margin-top:22px;display:grid;gap:8px;}
  .dfp .bar{display:grid;grid-template-columns:22px 1fr 32px;gap:10px;align-items:center;}
  .dfp .bar .lab{font-family:var(--mono);font-size:11px;color:var(--ink-3);}
  .dfp .bar .track{height:4px;background:var(--rule);border-radius:999px;overflow:hidden;}
  .dfp .bar .fill{height:100%;background:var(--blueprint);display:block;transition:width 1.1s cubic-bezier(.22,1,.36,1);}.dfp .review-sum.dfp-animate .bars .bar:nth-child(1) .fill{transition-delay:.05s}.dfp .review-sum.dfp-animate .bars .bar:nth-child(2) .fill{transition-delay:.18s}.dfp .review-sum.dfp-animate .bars .bar:nth-child(3) .fill{transition-delay:.31s}.dfp .review-sum.dfp-animate .bars .bar:nth-child(4) .fill{transition-delay:.44s}.dfp .review-sum.dfp-animate .bars .bar:nth-child(5) .fill{transition-delay:.57s}@media (prefers-reduced-motion:reduce){.dfp .bar .fill{transition:none}}
  .dfp .bar .ct{font-family:var(--mono);font-size:11px;color:var(--ink-3);text-align:right;}
  .dfp .review-list{display:grid;gap:16px;}
  .dfp .review{background:var(--paper);border:1px solid var(--rule);border-radius:8px;padding:24px;}
  .dfp .review .head{display:flex;justify-content:space-between;align-items:center;gap:12px;}
  .dfp .review .who{display:flex;align-items:center;gap:12px;}
  .dfp .review .ava{width:36px;height:36px;border-radius:999px;background:var(--blueprint-bg);color:var(--blueprint-deep);display:grid;place-items:center;font-family:var(--display);font-weight:600;font-size:14px;}
  .dfp .review .name{font-size:14px;font-weight:500;}
  .dfp .review .when{font-family:var(--mono);font-size:10px;color:var(--ink-3);letter-spacing:.08em;text-transform:uppercase;}
  .dfp .review .stars-inner{letter-spacing:1px;color:var(--blueprint);font-size:13px;}
  .dfp .review .ttl{font-family:var(--display);font-weight:600;font-size:18px;margin:14px 0 6px;letter-spacing:-.005em;}
  .dfp .review .body{color:var(--ink-2);font-size:14px;}
  .dfp .review .tags{display:flex;gap:6px;margin-top:14px;flex-wrap:wrap;}
  .dfp .review .tag{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);border:1px solid var(--rule-2);padding:3px 8px;border-radius:999px;}

  /* related */
  .dfp .related-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;}
  .dfp .card{background:var(--paper);border:1px solid var(--rule);border-radius:8px;overflow:hidden;transition:transform .2s ease,border-color .15s ease;display:block;}
  .dfp .card:hover{border-color:var(--ink-2);transform:translateY(-2px);}
  .dfp .card .frame{aspect-ratio:4/3;border-bottom:1px solid var(--rule);position:relative;overflow:hidden;background:var(--bg);}
  .dfp .card .frame .bg{position:absolute;inset:0;background:linear-gradient(var(--hairline) 1px,transparent 1px) 0 0/16px 16px,linear-gradient(90deg,var(--hairline) 1px,transparent 1px) 0 0/16px 16px,var(--bg);}
  .dfp .card .frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .dfp .card .body{padding:18px;}
  .dfp .card .nm{font-family:var(--display);font-weight:600;font-size:17px;line-height:1.2;letter-spacing:-.005em;}
  .dfp .card .mt{font-family:var(--mono);font-size:10px;color:var(--ink-3);letter-spacing:.08em;text-transform:uppercase;margin-top:6px;}
  .dfp .card .pr-row{display:flex;justify-content:space-between;align-items:center;margin-top:14px;}
  .dfp .card .pr{font-family:var(--display);font-weight:600;font-size:15px;}

  @media (max-width:1080px){
    .dfp .compat-grid{grid-template-columns:repeat(3,1fr);}
    .dfp .geom-grid{grid-template-columns:repeat(2,1fr);}
    .dfp .geom-cell:nth-child(2){border-right:0;}
    .dfp .geom-cell:nth-child(1),.dfp .geom-cell:nth-child(2){border-bottom:1px solid var(--rule);}
  }
  @media (max-width:980px){
    .dfp .hero-grid,.dfp .sec-head,.dfp .reviews{grid-template-columns:1fr;gap:32px;}
    .dfp .usp-grid,.dfp .related-grid{grid-template-columns:1fr 1fr;}
    .dfp .benefit-grid,.dfp .benefit-time{grid-template-columns:1fr;}
    .dfp .bt-cell.highlight{border-left:0;border-top:1px solid #DCD3FF;}
    .dfp .bt-arrow{transform:rotate(90deg);padding:14px 0;}
    .dfp h1.title{font-size:36px;}
    .dfp .sec-head h2{font-size:40px;}
    .dfp .manifest-head,.dfp .manifest-row{grid-template-columns:64px 1fr 80px 92px;}
    .dfp .manifest-head .purpose-col,.dfp .manifest-row .purpose{display:none;}
    .dfp .section{padding:64px 0;}
  }
  @media (max-width:600px){
    .dfp .container{padding:0 18px;}
    .dfp .usp-grid,.dfp .related-grid,.dfp .compat-grid{grid-template-columns:1fr 1fr;}
    .dfp .thumb-rail{grid-template-columns:repeat(3,1fr);}
    .dfp .sec-head h2{font-size:32px;}
    .dfp h1.title{font-size:30px;}
    .dfp .usp-badges{grid-template-columns:1fr;}
    .dfp .review-sum .big{font-size:64px;}
  }
  /* === PAGE ADJUSTMENTS === */
  /* Remove the decorative viewer controls from the main product image */
  .dfp .viewer-toolbar,
  .dfp .viewer-info,
  .dfp .viewer-controls { display: none !important; }

  /* Clean, borderless Usage + Included-formats blocks */
  .dfp .field { border: 0 !important; background: transparent !important; padding: 0 !important; }
  .dfp .usage-note { border: 0 !important; background: transparent !important; }
  /* === ADJUSTMENTS · ROUND 2 === */
  /* Product image fills its frame, no white space, no border */
  .dfp .viewer{ aspect-ratio:auto !important; border:0 !important; }
  .dfp .viewer .stage{ position:relative !important; padding:0 !important; }
  .dfp .viewer .stage img{ width:100% !important; height:auto !important; }

  /* Remove the seller row at the top of the buy box */
  .dfp .designer-row{ display:none !important; }

  /* Fix the boxed border on Usage / Included formats (theme .field collision) */
  .dfp .field{ display:block !important; border:0 !important; box-shadow:none !important; background:transparent !important; padding:0 !important; }
  .dfp .field::before,
  .dfp .field::after{ content:none !important; display:none !important; }
  /* === ADJUSTMENTS · ROUND 3 === */
  /* Colour the remaining format chips, and any future format */
  .dfp .fmt.source{ border-color:#CFE4E2 !important; color:#1F5F5A !important; background:#E3F1EF !important; }
  /* Breadcrumb link hover */
  .dfp .crumbs a:hover{ text-decoration:underline; }
  /* === ADJUSTMENTS · ROUND 4 === */
  /* Hide the format sub-lines on the 3 capability badges */
  .dfp .usp-badge .sub{ display:none !important; }

  /* Make the usage note larger / more readable */
  .dfp .usage-note{ font-size:15px !important; line-height:1.6 !important; max-width:60ch !important; }
  /* 3D model viewer */
  .dfp .viewer model-viewer{width:100%;height:100%;--poster-color:transparent;background:transparent;}
  .dfp .vt .vt-3d{position:absolute;top:5px;right:5px;font-family:var(--mono);font-size:9px;letter-spacing:.06em;background:var(--blueprint);color:#fff;padding:2px 5px;border-radius:4px;z-index:3;}
  /* Force the 3D viewer to fill the stage so it can't collapse */
  .dfp .viewer .stage{ position:relative !important; min-height:480px; }
  .dfp .viewer .stage model-viewer{ position:absolute !important; inset:0 !important; width:100% !important; height:100% !important; display:block !important; }
  .dfp .viewer .stage model-viewer.dfp-hide{ display:none !important; }
  .dfp .viewer .stage img.dfp-swap{ position:absolute !important; inset:0 !important; width:100% !important; height:100% !important; object-fit:contain; }
  .dfp .viewer .stage video.dfp-vid{ position:absolute !important; inset:0 !important; width:100% !important; height:100% !important; object-fit:contain; background:#000; z-index:3; }
</style>

{%- liquid
  assign sub_fallback = product.description | strip_html | truncate: 180
  assign cur = product.selected_or_first_available_variant
-%}
<div class="dfp">

  {%- if section.settings.show_announce -%}
  <div class="announce">
    <span>{{ section.settings.ann1 }}</span>{%- if section.settings.ann2 != blank -%}<span class="dot">•</span><span>{{ section.settings.ann2 }}</span>{%- endif -%}{%- if section.settings.ann3 != blank -%}<span class="dot">•</span><span>{{ section.settings.ann3 }}</span>{%- endif -%}
  </div>
  {%- endif -%}

  {%- if section.settings.show_crumbs -%}
  <div class="container crumbs">
    <a href="{{ routes.root_url }}">Home</a><span class="sep">/</span>
    {%- assign bc_collection = collection | default: product.collections.first -%}
    {%- if bc_collection -%}<a href="{{ bc_collection.url }}">{{ bc_collection.title }}</a><span class="sep">/</span>{%- endif -%}
    <span class="here">{{ product.title }}</span>
  </div>
  {%- endif -%}

  <main class="hero">
    <div class="container hero-grid">

      <!-- VIEWER (real product gallery, blueprint styling) -->
      <div>
        <div class="viewer">
          <div class="grid-bg"></div>
          <div class="viewer-toolbar">
            <button type="button" class="vt-btn" data-active="true" onclick="dfpMode(this)">{{ section.settings.view_mode1 | default: 'Solid' }}</button>
            <button type="button" class="vt-btn" data-active="false" onclick="dfpMode(this)">{{ section.settings.view_mode2 | default: 'Wireframe' }}</button>
            <button type="button" class="vt-btn" data-active="false" onclick="dfpMode(this)">{{ section.settings.view_mode3 | default: 'X-ray' }}</button>
          </div>
          <div class="viewer-info">
            <span class="live">{{ section.settings.view_info1 | default: '3D MODEL · 24,812 polys' }}</span>
            {%- if section.settings.view_info2 != blank -%}<span>{{ section.settings.view_info2 }}</span>{%- endif -%}
          </div>
          <div class="stage" id="dfpStage">
            {%- assign themodel = nil -%}
            {%- for m in product.media -%}
              {%- if m.media_type == 'model' -%}{%- assign themodel = m -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- if themodel -%}
              {%- assign glb_src = '' -%}
              {%- for s in themodel.sources -%}
                {%- if s.format == 'glb' -%}{%- assign glb_src = s.url -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
              <model-viewer class="dfp-hide" data-glb="{{ glb_src }}" camera-controls auto-rotate ar ar-modes="webxr scene-viewer quick-look" shadow-intensity="1" reveal="auto" poster="{{ themodel.preview_image | image_url: width: 1100 }}" alt="{{ product.title | escape }}" style="width:100%;height:100%;"></model-viewer>
            {%- endif -%}
            {%- if product.media.size > 0 -%}
              {%- assign fm = product.media.first -%}
              <img class="dfp-swap" src="{{ fm.preview_image | image_url: width: 1100 }}" alt="{{ fm.alt | escape | default: product.title | escape }}">
            {%- elsif themodel == nil -%}
              <svg class="ph" width="220" height="170" viewBox="0 0 220 170" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="20" y="60" width="180" height="70" rx="3"/><path d="M40 60 L70 30 L150 30 L180 60"/><path d="M70 30 L70 130 M150 30 L150 130" stroke-dasharray="3 4" stroke-width="0.8"/></svg>
            {%- endif -%}
          </div>
          <div class="viewer-controls">
            <div class="vc-axes">
              <button type="button" data-active="true" onclick="dfpAxis(this)">{{ section.settings.axis1 | default: '3/4' }}</button>
              <button type="button" data-active="false" onclick="dfpAxis(this)">{{ section.settings.axis2 | default: 'FRONT' }}</button>
              <button type="button" data-active="false" onclick="dfpAxis(this)">{{ section.settings.axis3 | default: 'SIDE' }}</button>
              <button type="button" data-active="false" onclick="dfpAxis(this)">{{ section.settings.axis4 | default: 'TOP' }}</button>
            </div>
            <div class="vc-actions">
              <button type="button" aria-label="Rotate"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5"/></svg></button>
              <button type="button" aria-label="Measure"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17 17 3l4 4L7 21 3 17Z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/></svg></button>
              <button type="button" aria-label="Fullscreen"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9V3h6M21 9V3h-6M3 15v6h6M21 15v6h-6"/></svg></button>
            </div>
          </div>
          {%- if product.media.size > 1 -%}<button type="button" class="dfp-nav dfp-nav-prev" aria-label="Previous" onclick="dfpNav(-1)"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></button><button type="button" class="dfp-nav dfp-nav-next" aria-label="Next" onclick="dfpNav(1)"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></button>{%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
        <div class="thumb-rail">
          {%- for media in product.media -%}
            {%- assign vsrc = '' -%}{%- if media.media_type == 'video' -%}{%- assign _mp4 = media.sources | where: 'format', 'mp4' -%}{%- if _mp4.size > 0 -%}{%- assign vsrc = _mp4.last.url -%}{%- endif -%}{%- endif -%}
            <button type="button" class="vt" data-active="{% if forloop.first %}true{% else %}false{% endif %}" data-media-type="{{ media.media_type }}" data-media-id="{{ media.id }}" data-video-src="{{ vsrc }}" onclick="dfpSwap(this,'{{ media.preview_image | image_url: width: 1100 }}')">
              <span class="vt-bg"></span>
              <img src="{{ media.preview_image | image_url: width: 220 }}" alt="{{ media.alt | escape }}">
              {%- if media.media_type == 'model' -%}<span class="vt-3d">3D</span>{%- endif -%}
              {%- if media.media_type == 'video' -%}<span class="vt-3d">&#9654;</span>{%- endif -%}
              <span class="vt-label">{{ forloop.index }}</span>
            </button>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>

      <!-- BUY BOX -->
      <div>
        <div class="designer-row">
          <span class="ava">{{ section.settings.designer_ava | default: 'SK' }}</span>
          <span><strong style="color:var(--ink)">{{ section.settings.designer_name | default: 'Studio Kanso' }}</strong>{%- if section.settings.designer_files != blank -%} · {{ section.settings.designer_files }}{%- endif -%}</span>
          {%- if section.settings.verified_label != blank -%}<span class="verified">{{ section.settings.verified_label }}</span>{%- endif -%}
        </div>

        <h1 class="title">{{ section.settings.title_override | default: product.title }}</h1>
        <p class="subtitle">{{ section.settings.subtitle | default: sub_fallback }}</p>

        <div class="stat-row">
          <span style="display:inline-flex;gap:8px;align-items:center">
            <span class="stars-inner">★★★★★</span>
          </span>
          {%- if section.settings.stat_version != blank -%}<span class="sep"></span><span class="mono">{{ section.settings.stat_version }}</span>{%- endif -%}
        </div>

        <div class="usp-badges">
          <div class="usp-badge"><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-2M6 14h12v7H6z"/></svg></span><div><div class="ttl">{{ section.settings.badge1_ttl | default: '3D Printable' }}</div><div class="sub">{{ section.settings.badge1_sub | default: 'STL · 3MF · OBJ' }}</div></div></div>
          <div class="usp-badge"><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h6m12 0h-6M12 3v6m0 12v-6"/><circle cx="12" cy="12" r="2.5"/></svg></span><div><div class="ttl">{{ section.settings.badge2_ttl | default: 'Laser Cuttable' }}</div><div class="sub">{{ section.settings.badge2_sub | default: 'DXF · SVG · AI' }}</div></div></div>
          <div class="usp-badge"><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v8H4z"/><path d="M8 12v6M16 12v6M6 20h12"/></svg></span><div><div class="ttl">{{ section.settings.badge3_ttl | default: 'Manufacturing' }}</div><div class="sub">{{ section.settings.badge3_sub | default: 'STEP · IGES' }}</div></div></div>
        </div>

        {%- if section.settings.usage_note != blank or section.settings.usage_pick != blank -%}
        <div class="field">
          <div class="field-label"><span>{{ section.settings.usage_label | default: 'Usage' }}</span>{%- if section.settings.usage_pick != blank -%}<span class="pick">{{ section.settings.usage_pick }}</span>{%- endif -%}</div>
          {%- if section.settings.usage_note != blank -%}<div class="usage-note">{{ section.settings.usage_note }}</div>{%- endif -%}
        </div>
        {%- endif -%}

        {%- assign fmt_metas = product.metafields.shopify["file-format-type"].value -%}
        {%- if fmt_metas != blank and fmt_metas.size > 0 -%}
        <div class="field">
          <div class="field-label"><span>{{ section.settings.formats_label | default: 'Included formats' }}</span>{%- if section.settings.formats_count != blank -%}<span class="mono" style="color:var(--ink-2)">{{ section.settings.formats_count }}</span>{%- endif -%}</div>
          <div class="formats">
            {%- assign t_print = 'STL,3MF,OBJ' | split: ',' -%}
            {%- assign t_laser = 'DXF,SVG,AI' | split: ',' -%}
            {%- assign t_cnc = 'STEP,IGES' | split: ',' -%}
            {%- for mo in fmt_metas -%}
              {%- assign lbl = mo.label | default: mo.system.handle | upcase -%}
              {%- assign tag = 'source' -%}
              {%- if t_print contains lbl -%}{%- assign tag = 'printable' -%}{%- elsif t_laser contains lbl -%}{%- assign tag = 'laser' -%}{%- elsif t_cnc contains lbl -%}{%- assign tag = 'cnc' -%}{%- endif -%}
              <span class="fmt {{ tag }}">{{ lbl }}</span>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        <div class="price-row">
          <span class="price">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}<span class="price-compare">{{ product.compare_at_price | money }}</span>{%- endif -%}
        </div>

        {%- form 'product', product, id: 'dfp-form' -%}
          <input type="hidden" name="id" value="{{ cur.id }}">
          {%- if product.variants.size > 1 -%}
          <div class="field" style="margin-top:14px">
            <div class="field-label"><span>{{ section.settings.variant_label | default: 'License' }}</span></div>
            <select name="id" class="usage-note" style="width:100%;padding:12px 14px;border:1px solid var(--rule-2);border-radius:8px;background:var(--paper);font-family:var(--sans);font-size:14px;color:var(--ink)">
              {%- for v in product.variants -%}<option value="{{ v.id }}"{% unless v.available %} disabled{% endunless %}>{{ v.title }}, {{ v.price | money }}</option>{%- endfor -%}
            </select>
          </div>
          {%- endif -%}
          <div class="cta-row">
            <button type="submit" class="cta blueprint"{% unless product.available %} disabled{% endunless %}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14"/></svg>
              {%- if product.available -%}Add to Cart{%- else -%}{{ section.settings.cta_sold | default: 'Sold out' }}{%- endif -%}
            </button>
          </div>
        {%- endform -%}
        <div class="meta-line">Secure checkout &middot; files delivered after purchase</div>

        <div class="quickfacts">
          {%- if section.settings.qf1_k != blank -%}<div class="qf"><span class="k">{{ section.settings.qf1_k }}</span><span class="v">{{ section.settings.qf1_v }}</span></div>{%- endif -%}
          {%- if section.settings.qf2_k != blank -%}<div class="qf"><span class="k">{{ section.settings.qf2_k }}</span><span class="v">{{ section.settings.qf2_v }}</span></div>{%- endif -%}
          {%- if section.settings.qf3_k != blank -%}<div class="qf"><span class="k">{{ section.settings.qf3_k }}</span><span class="v">{{ section.settings.qf3_v }}</span></div>{%- endif -%}
        </div>
      </div>

    </div>
  </main>

  {%- if section.settings.show_benefits -%}
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div><h2>{{ section.settings.benefits_h | default: 'Made for your own projects.' }}</h2></div>
        <div class="lede">{{ section.settings.benefits_lede }}</div>
      </div>
      <div class="benefit-time">
        <div class="bt-cell"><div class="k">{{ section.settings.bt1_k | default: 'The designer spent' }}</div><div class="v">{{ section.settings.bt1_v | default: '18 hours' }}</div><div class="s">{{ section.settings.bt1_s }}</div></div>
        <div class="bt-arrow"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></div>
        <div class="bt-cell highlight"><div class="k">{{ section.settings.bt2_k | default: 'You get it in' }}</div><div class="v">{{ section.settings.bt2_v | default: 'under 1 minute' }}</div><div class="s">{{ section.settings.bt2_s }}</div></div>
      </div>
      <div class="benefit-grid">
        <div class="benefit"><div class="ico-wrap"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17 17 3l4 4L7 21 3 17Z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/></svg></div><h3>{{ section.settings.ben1_h | default: 'Designers' }}</h3><p>{{ section.settings.ben1_p }}</p></div>
        <div class="benefit"><div class="ico-wrap"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v8H4z"/><path d="M8 12v6M16 12v6M6 20h12"/></svg></div><h3>{{ section.settings.ben2_h | default: 'Architects' }}</h3><p>{{ section.settings.ben2_p }}</p></div>
        <div class="benefit"><div class="ico-wrap"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-2M6 14h12v7H6z"/></svg></div><h3>{{ section.settings.ben3_h | default: 'Hobbyists' }}</h3><p>{{ section.settings.ben3_p }}</p></div>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- if section.settings.show_usp -%}
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div><h2>{{ section.settings.usp_h | default: 'One file pack, three ways to fabricate.' }}</h2></div>
        <div class="lede">{{ section.settings.usp_lede }}</div>
      </div>
      <div class="usp-grid">
        <div class="usp printable">
          <span class="num">{{ section.settings.uspc1_num | default: 'USP-01' }}</span>
          <div class="ico-wrap"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-2M6 14h12v7H6z"/></svg></div>
          <h3>{{ section.settings.uspc1_h | default: '3D-printable, end to end.' }}</h3>
          <p>{{ section.settings.uspc1_p }}</p>
          <ul class="check-list">
            {%- if section.settings.uspc1_c1 != blank -%}<li><span class="c">✓</span><span>{{ section.settings.uspc1_c1 }}</span></li>{%- endif -%}
