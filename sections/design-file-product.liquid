<script>
(function(){
  function grp(el){ return el.closest('.viewer-toolbar, .vc-axes'); }
  window.dfpMode=function(b){ var g=grp(b); if(!g)return; g.querySelectorAll('button').forEach(function(x){x.setAttribute('data-active','false');}); b.setAttribute('data-active','true'); };
  window.dfpAxis=function(b){ var g=grp(b); if(!g)return; g.querySelectorAll('button').forEach(function(x){x.setAttribute('data-active','false');}); b.setAttribute('data-active','true'); };
  window.dfpSwap=function(b,src){ var st=document.getElementById('dfpStage'); if(!st)return; var mv=st.querySelector('model-viewer'); var img=st.querySelector('img.dfp-swap'); var vid=st.querySelector('video.dfp-vid'); var type=b.getAttribute('data-media-type'); if(mv)mv.classList.add('dfp-hide'); if(img)img.style.display='none'; if(vid){ try{vid.pause();}catch(e){} vid.style.display='none'; } if(type==='model'){ if(mv){ if(!mv.getAttribute('src') && mv.dataset.glb){ mv.setAttribute('src', mv.dataset.glb); } mv.classList.remove('dfp-hide'); } } else if(type==='video'){ var vs=b.getAttribute('data-video-src'); if(vs){ if(!vid){ vid=document.createElement('video'); vid.className='dfp-vid'; vid.setAttribute('playsinline',''); vid.setAttribute('controls',''); vid.setAttribute('loop',''); vid.muted=true; vid.setAttribute('preload','metadata'); st.appendChild(vid); } if(vid.getAttribute('src')!==vs){ vid.setAttribute('src', vs); } vid.style.display='block'; try{vid.play();}catch(e){} } else if(img){ img.src=src; img.style.display='block'; img.style.zIndex='2'; } } else { if(img){ img.src=src; img.style.display='block'; img.style.zIndex='2'; } } document.querySelectorAll('.dfp .thumb-rail .vt').forEach(function(x){x.setAttribute('data-active','false');}); b.setAttribute('data-active','true'); };
  window.dfpNav=function(d){ var th=document.querySelectorAll('.dfp .thumb-rail .vt'); if(!th.length)return; var cur=0; for(var i=0;i<th.length;i++){ if(th[i].getAttribute('data-active')==='true'){cur=i;break;} } var n=(cur+d+th.length)%th.length; th[n].click(); };
  window.dfpFaq=function(item){ var open=item.classList.contains('open'); item.parentElement.querySelectorAll('.faq-item').forEach(function(i){i.classList.remove('open'); var t=i.querySelector('.toggle'); if(t)t.textContent='+';}); if(!open){ item.classList.add('open'); var t=item.querySelector('.toggle'); if(t)t.textContent='-'; } };
})();
</script>
<script>
(function(){try{var s=document.querySelector('.dfp .review-sum');if(!s)return;var fills=s.querySelectorAll('.bar .fill');var done=false;function go(){if(done)return;done=true;s.classList.add('dfp-animate');for(var i=0;i<fills.length;i++){var f=fills[i],t=f.style.width;f.style.transition='none';f.style.width='0';void f.offsetWidth;f.style.transition='';f.style.width=t;}}if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){go();io.disconnect();}});},{threshold:0,rootMargin:'0px 0px -12% 0px'});io.observe(s);}else{go();}}catch(e){}})();
</script>

