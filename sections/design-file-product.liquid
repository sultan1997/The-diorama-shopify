    <div class="container">
      <div class="sec-head">
        <div><h2>{{ section.settings.manifest_h | default: 'Every file, nothing hidden.' }}</h2></div>
        <div class="lede">{{ section.settings.manifest_lede }}</div>
      </div>
      <div class="manifest">
        <div class="manifest-head">
          <span>{{ section.settings.man_col1 | default: 'Format' }}</span>
          <span>{{ section.settings.man_col2 | default: 'Filename' }}</span>
          <span>{{ section.settings.man_col3 | default: 'Size' }}</span>
          <span>{{ section.settings.man_col4 | default: 'Category' }}</span>
          <span class="purpose-col">{{ section.settings.man_col5 | default: 'Purpose' }}</span>
        </div>
