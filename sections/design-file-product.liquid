  {%- if section.settings.show_related and product.collections.first -%}
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div><h2>{{ section.settings.related_h | default: 'More 3D Design Files' }}</h2></div>
        <div class="lede">{{ section.settings.related_lede }}</div>
      </div>
      <div class="related-grid">
