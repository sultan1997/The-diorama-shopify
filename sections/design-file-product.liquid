        <div class="manifest-row" {{ b.shopify_attributes }}>
          <span><span class="ext {{ b.settings.tag }}">{{ b.settings.ext }}</span></span>
          <span class="nm">{{ b.settings.nm }}</span>
          <span class="size">{{ b.settings.size }}</span>
          <span class="ct">{{ b.settings.category }}</span>
