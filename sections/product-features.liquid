{%- comment -%}
  ============================================================
  THE DIORAMA — Section 01: "What you are paying for"
  Fully editable product feature section.

  WHAT YOU CAN EDIT IN THE THEME EDITOR (no code needed):
    • Eyebrow number + label
    • Heading + italic accent line
    • Intro body paragraph
    • Each feature card: image (auto-cropped square), index,
      label, caption chip, title, description
    • Add / remove / reorder cards
    • Image ratio, columns, colours, spacing

  HOW TO INSTALL:
    1. In your theme code editor: Sections → Add a new section →
       name it "product-features" → paste this whole file → Save.
       (Or upload product-features.liquid into the /sections folder.)
    2. Open the product template in the Theme Editor
       (Customize → Products → Default product).
    3. "Add section" → choose "Section 01 · Features".
    4. Edit everything from the right-hand panel.

  All images are forced to a true 1:1 square crop on the Shopify
  CDN, so non-square uploads still display perfectly square.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

{%- if s.load_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,400;0,600;0,700;0,800;1,500;1,600&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
{%- endif -%}

<style>
  #di-feat-{{ uid }} {
    --di-bg: {{ s.bg_color }};
    --di-ink: {{ s.heading_color }};
    --di-muted: {{ s.text_color }};
    --di-faint: #9C9CA3;
    --di-accent: {{ s.accent_color }};
    --di-rule: #E5E5E5;
    --di-hairline: #EDEDED;
    --di-surface: #F4F4F5;
    --di-radius: 12px;
    --di-serif: "Raleway", "Helvetica Neue", Helvetica, Arial, sans-serif;
    --di-sans: "Roboto", "Helvetica Neue", Helvetica, Arial, sans-serif;
    --di-ratio: {{ s.image_ratio }};
    --di-cols: {{ s.columns_desktop }};

    background: var(--di-bg);
    color: var(--di-ink);
    font-family: var(--di-sans);
    -webkit-font-smoothing: antialiased;
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
  }
  #di-feat-{{ uid }} * { box-sizing: border-box; }
  #di-feat-{{ uid }} .di-wrap {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- HEADER ---------- */
  #di-feat-{{ uid }} .di-eyebrow {
    font-family: var(--di-sans);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--di-faint);
    margin-bottom: 22px;
  }
  #di-feat-{{ uid }} .di-eyebrow .di-num { color: var(--di-accent); }
  #di-feat-{{ uid }} .di-head {
    display: grid;
    grid-template-columns: minmax(0,1.15fr) minmax(0,1fr);
    gap: 24px 56px;
    align-items: start;
    margin-bottom: 48px;
  }
  #di-feat-{{ uid }} .di-title {
    font-family: var(--di-serif);
    font-weight: 700;
    font-size: clamp(34px, 4.6vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--di-ink);
  }
  #di-feat-{{ uid }} .di-title em {
    font-style: italic;
    font-weight: 500;
    color: var(--di-faint);
  }
  #di-feat-{{ uid }} .di-body {
    color: var(--di-muted);
    font-size: 16px;
    line-height: 1.6;
    max-width: 52ch;
    align-self: center;
  }
  #di-feat-{{ uid }} .di-body p { margin: 0 0 0.7em; }
  #di-feat-{{ uid }} .di-body p:last-child { margin-bottom: 0; }

  /* ---------- GRID ---------- */
  #di-feat-{{ uid }} .di-grid {
    display: grid;
    grid-template-columns: repeat(var(--di-cols), minmax(0,1fr));
    gap: 32px;
  }
  #di-feat-{{ uid }} .di-card { display: flex; flex-direction: column; }

  #di-feat-{{ uid }} .di-card__media {
    position: relative;
    aspect-ratio: var(--di-ratio);
    width: 100%;
    border: 1px solid var(--di-rule);
    border-radius: var(--di-radius);
    overflow: hidden;
    background: var(--di-surface);
  }
  #di-feat-{{ uid }} .di-card__media img,
  #di-feat-{{ uid }} .di-card__media svg {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  #di-feat-{{ uid }} .di-card__media .placeholder-svg {
    width: 100%; height: 100%;
    fill: #C9C9CE; background: var(--di-surface);
  }
  #di-feat-{{ uid }} .di-chip {
    position: absolute; left: 12px; bottom: 12px;
    font-family: var(--di-sans);
    font-size: 10px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--di-muted);
    background: rgba(255,255,255,0.88);
    -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
    padding: 5px 9px;
    border: 1px solid var(--di-rule);
    border-radius: 999px;
  }

  #di-feat-{{ uid }} .di-card__meta {
    display: flex; align-items: baseline; gap: 10px;
    margin-top: 18px;
  }
  #di-feat-{{ uid }} .di-card__index {
    font-family: var(--di-sans);
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--di-accent);
  }
  #di-feat-{{ uid }} .di-card__label {
    font-family: var(--di-sans);
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--di-faint);
  }
  #di-feat-{{ uid }} .di-card__title {
    font-family: var(--di-serif);
    font-weight: 700;
    font-size: 25px; line-height: 1.14;
    letter-spacing: -0.01em;
    color: var(--di-ink);
    margin: 8px 0 8px;
  }
  #di-feat-{{ uid }} .di-card__desc {
    color: var(--di-muted);
    font-size: 14px; line-height: 1.55;
    margin: 0;
  }
  #di-feat-{{ uid }} .di-card__desc p { margin: 0; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 990px) {
    #di-feat-{{ uid }} .di-head { grid-template-columns: 1fr; gap: 18px; }
    #di-feat-{{ uid }} .di-grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 24px; }
  }
  @media (max-width: 600px) {
    #di-feat-{{ uid }} .di-grid { grid-template-columns: 1fr; }
  }
</style>

<section id="di-feat-{{ uid }}">
  <div class="di-wrap">

    {%- comment -%} ---------- Section header ---------- {%- endcomment -%}
    {%- if s.eyebrow_number != blank or s.eyebrow_label != blank -%}
      <div class="di-eyebrow">
        {%- if s.eyebrow_number != blank -%}<span class="di-num">{{ s.eyebrow_number }}</span>{%- endif -%}
        {%- if s.eyebrow_number != blank and s.eyebrow_label != blank -%} &mdash; {%- endif -%}
        {%- if s.eyebrow_label != blank -%}<span>{{ s.eyebrow_label }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="di-head">
      {%- if s.heading != blank or s.heading_accent != blank -%}
        <h2 class="di-title">
          {{ s.heading }}
          {%- if s.heading_accent != blank %} <em>{{ s.heading_accent }}</em>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if s.body != blank -%}
        <div class="di-body">{{ s.body }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Feature cards ---------- {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="di-grid">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="di-card" {{ block.shopify_attributes }}>
            <div class="di-card__media">
              {%- if b.image != blank -%}
                <img
                  src="{{ b.image | image_url: width: 800, height: 800, crop: 'center' }}"
                  srcset="{{ b.image | image_url: width: 400, height: 400, crop: 'center' }} 400w,
                          {{ b.image | image_url: width: 800, height: 800, crop: 'center' }} 800w,
                          {{ b.image | image_url: width: 1200, height: 1200, crop: 'center' }} 1200w"
                  sizes="(min-width: 990px) 30vw, (min-width: 600px) 45vw, 90vw"
                  alt="{{ b.image.alt | default: b.title | escape }}"
                  width="800" height="800"
                  loading="lazy">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {%- if b.image_caption != blank -%}
                <span class="di-chip">{{ b.image_caption }}</span>
              {%- endif -%}
            </div>

            {%- if b.index != blank or b.label != blank -%}
              <div class="di-card__meta">
                {%- if b.index != blank -%}<span class="di-card__index">{{ b.index }}</span>{%- endif -%}
                {%- if b.label != blank -%}<span class="di-card__label">{{ b.label }}</span>{%- endif -%}
              </div>
            {%- endif -%}

            {%- if b.title != blank -%}<h3 class="di-card__title">{{ b.title }}</h3>{%- endif -%}
            {%- if b.description != blank -%}<div class="di-card__desc">{{ b.description }}</div>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Section 01 · Features",
  "tag": "section",
  "class": "di-section-features",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow_number", "label": "Eyebrow — number", "default": "Section 01" },
    { "type": "text", "id": "eyebrow_label", "label": "Eyebrow — label", "default": "What you are paying for" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Precision at every fitting." },
    { "type": "text", "id": "heading_accent", "label": "Heading — italic accent", "default": "Nothing missed." },
    { "type": "richtext", "id": "body", "label": "Intro paragraph",
      "default": "<p>What is this? This is an offshore support vessel miniature made for Priya Blue Shipping Company. It is used as a corporate gift to their clients, so it stays as a memory for years.</p>" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "4/5", "label": "Portrait (4:5)" }
      ], "default": "1/1" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "max_width", "label": "Max content width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },

    { "type": "header", "content": "Colours (brand defaults)" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#3D3D3D" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#6B6B72" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#3912FF" },

    { "type": "header", "content": "Fonts" },
    { "type": "checkbox", "id": "load_fonts", "label": "Load brand fonts (Raleway + Roboto)", "default": true },
    { "type": "paragraph", "content": "Turn this off if your theme already loads Raleway and Roboto." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (auto-cropped square)" },
        { "type": "text", "id": "image_caption", "label": "Image caption chip", "default": "Macro · Hull" },
        { "type": "text", "id": "index", "label": "Index", "default": "F-01" },
        { "type": "text", "id": "label", "label": "Small label", "default": "Detail" },
        { "type": "text", "id": "title", "label": "Title", "default": "Hand-finished hull" },
        { "type": "richtext", "id": "description", "label": "Description",
          "default": "<p>Every plank line, port and fitting is built to the original drawings and finished by hand.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Section 01 · Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "image_caption": "Macro · Hull",
            "index": "F-01",
            "label": "Detail",
            "title": "Hand-finished hull",
            "description": "<p>Every plank line, port and fitting is built to the original drawings and finished by hand.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "image_caption": "Macro · Fittings",
            "index": "F-02",
            "label": "Detail",
            "title": "Solid brass fittings",
            "description": "<p>Individually cast metal components, never moulded plastic, at true scale.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "image_caption": "Macro · Base",
            "index": "F-03",
            "label": "Detail",
            "title": "Engraved display base",
            "description": "<p>Solid timber base with an engraved nameplate and protective acrylic case.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
