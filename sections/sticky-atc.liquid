{% comment %}
  Sticky add-to-cart bar for product pages.

  Rendered from the footer section group, so it covers every product
  template without touching them individually. The template guard below
  keeps it off every other page type.

  Mirrors the main CTA (.tdp-btn-cart inside #tdp-form) rendered by the
  diorama-product section. The bar slides up once that button has scrolled
  above the viewport, and clicking it forwards the click to the real button
  so quantity, personalisation and variant handling stay in one place.

  Personalisation: if the product offers engraving text and the field is
  still empty, the bar sends the shopper to that field instead of adding an
  un-engraved piece. Scrolling the buy box back into view hides the bar, so
  they simply continue with the real button.

  If a product template has no diorama-product buy box, the script removes
  the bar on load rather than showing a button that does nothing.
{% endcomment %}

{%- if section.settings.enabled and template.name == 'product' and product != blank -%}
  <style>
    .tdp-sticky{
      position:fixed;left:0;right:0;bottom:0;z-index:9997;
      background:#fff;border-top:1px solid #e8e8e8;
      box-shadow:0 -6px 28px rgba(0,0,0,.10);
      transform:translateY(110%);
      transition:transform .3s cubic-bezier(.4,0,.2,1);
      will-change:transform;
    }
    .tdp-sticky[data-show="1"]{transform:translateY(0)}
    .tdp-sticky-in{
      max-width:1280px;margin:0 auto;padding:10px 20px;
      display:flex;align-items:center;gap:16px;
    }
    .tdp-sticky-media{
      width:48px;height:48px;flex:0 0 48px;
      object-fit:cover;background:#f3f3f3;display:block;
    }
    .tdp-sticky-txt{flex:1 1 auto;min-width:0}
    .tdp-sticky-title{
      font-family:"DM Sans",Arial,sans-serif;font-size:13px;font-weight:600;
      color:#111;line-height:1.3;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
    }
    .tdp-sticky-price{
      font-family:"DM Sans",Arial,sans-serif;font-size:13px;font-weight:700;
      color:#111;margin-top:2px;
    }
    .tdp-sticky-btn{
      flex:0 0 auto;background:#3A13FF;color:#fff;border:0;border-radius:0;
      font-family:"DM Sans",Arial,sans-serif;font-size:10px;font-weight:700;
      letter-spacing:1.7px;text-transform:uppercase;
      padding:15px 36px;cursor:pointer;transition:opacity .2s;
    }
    .tdp-sticky-btn:hover{opacity:.86}
    .tdp-sticky-btn:disabled{background:#9b9b9b;cursor:not-allowed}

    /* Draws the eye to the engraving field when the bar sends them there. */
    @keyframes tdp-perso-flash{
      0%,100%{box-shadow:0 0 0 0 rgba(58,19,255,0)}
      15%,65%{box-shadow:0 0 0 3px rgba(58,19,255,.35)}
    }
    .tdp-perso-flash{animation:tdp-perso-flash 1.5s ease-out}

    /* Lift the floating WhatsApp button clear of the bar. */
    body.tdp-sticky-on .td-wa{bottom:104px;transition:bottom .3s cubic-bezier(.4,0,.2,1)}

    @media (max-width:749px){
      .tdp-sticky-in{gap:12px;padding:9px 14px}
      .tdp-sticky-media,.tdp-sticky-title{display:none}
      .tdp-sticky-price{font-size:15px;margin-top:0;flex:0 0 auto}
      .tdp-sticky-btn{flex:1 1 auto;padding:15px 10px;text-align:center}
      body.tdp-sticky-on .td-wa{bottom:88px}
    }
    {%- if section.settings.visible_on == 'mobile' %}
    @media (min-width:750px){.tdp-sticky{display:none}}
    {%- endif %}
    {%- if section.settings.visible_on == 'desktop' %}
    @media (max-width:749px){.tdp-sticky{display:none}}
    {%- endif %}
    @media (prefers-reduced-motion:reduce){
      .tdp-sticky,body.tdp-sticky-on .td-wa{transition:none}
      .tdp-perso-flash{animation:none;box-shadow:0 0 0 3px rgba(58,19,255,.35)}
    }
  </style>

  <div class="tdp-sticky" data-show="0" aria-hidden="true" {{ section.shopify_attributes }}>
    <div class="tdp-sticky-in">
      {%- if section.settings.show_image and product.featured_image -%}
        <img
          class="tdp-sticky-media"
          src="{{ product.featured_image | image_url: width: 96 }}"
          alt=""
          width="48"
          height="48"
          loading="lazy"
        >
      {%- endif -%}
      <div class="tdp-sticky-txt">
        <div class="tdp-sticky-title">{{ product.title }}</div>
        <div class="tdp-sticky-price" data-sticky-price>
          {{- product.selected_or_first_available_variant.price | money -}}
        </div>
      </div>
      <button type="button" class="tdp-sticky-btn" data-sticky-btn>
        {{- 'products.product.add_to_cart' | t -}}
      </button>
    </div>
  </div>

  <script>
    (function () {
      // The theme editor can re-render this section; keep only the newest bar.
      var bars = document.querySelectorAll('.tdp-sticky');
      for (var i = 0; i < bars.length - 1; i++) bars[i].remove();
      var bar = bars[bars.length - 1];
      if (!bar) return;

      var btn = bar.querySelector('[data-sticky-btn]');
      var priceEl = bar.querySelector('[data-sticky-price]');
      var modal = document.getElementById('tdp-modal');

      function mainBtn() { return document.querySelector('.tdp-actions .tdp-btn-cart'); }
      function persoInput() { return document.getElementById('tdp-perso-input'); }

      var main = mainBtn();
      // Product templates without the diorama-product buy box get no bar.
      if (!btn || !main) { bar.remove(); return; }

      var shown = false;
      var past = false;

      function modalOpen() {
        return !!modal && getComputedStyle(modal).display !== 'none';
      }

      function apply() {
        var next = past && !modalOpen();
        if (next === shown) return;
        shown = next;
        bar.setAttribute('data-show', next ? '1' : '0');
        bar.setAttribute('aria-hidden', next ? 'false' : 'true');
        document.body.classList.toggle('tdp-sticky-on', next);
      }

      // Keep label, availability and price in step with the real buy box.
      function sync() {
        var m = mainBtn();
        if (!m) return;
        btn.textContent = (m.textContent || 'Add to cart').trim();
        btn.disabled = !!m.disabled;
        var p = document.getElementById('tdpPrice');
        if (p && priceEl) priceEl.textContent = p.textContent.trim();
      }
      sync();

      // Send the shopper to the engraving field rather than adding a blank one.
      // Focus first so the tap still counts as a user gesture on iOS, then scroll.
      function promptForPersonalisation(input) {
        var reduce = window.matchMedia
          && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var target = input.closest ? (input.closest('.tdp-perso') || input) : input;

        try { input.focus({ preventScroll: true }); } catch (e) { input.focus(); }
        try {
          target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
        } catch (e) {
          target.scrollIntoView();
        }

        input.classList.remove('tdp-perso-flash');
        void input.offsetWidth; // restart the animation if it is already running
        input.classList.add('tdp-perso-flash');
        setTimeout(function () { input.classList.remove('tdp-perso-flash'); }, 1600);
      }

      btn.addEventListener('click', function () {
        var m = mainBtn();
        if (!m || m.disabled) return;

        var p = persoInput();
        if (p && !p.value.trim()) {
          promptForPersonalisation(p);
          return;
        }

        m.click();
      });

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          var e = entries[0];
          past = !e.isIntersecting && e.boundingClientRect.top < 0;
          apply();
        }, { threshold: 0 }).observe(main);
      } else {
        window.addEventListener('scroll', function () {
          past = main.getBoundingClientRect().bottom < 0;
          apply();
        }, { passive: true });
      }

      if (window.MutationObserver) {
        var actions = main.parentNode;
        if (actions) {
          new MutationObserver(sync).observe(actions, {
            childList: true, subtree: true, characterData: true,
            attributes: true, attributeFilter: ['disabled']
          });
        }
        var priceNode = document.getElementById('tdpPrice');
        if (priceNode) {
          new MutationObserver(sync).observe(priceNode, {
            childList: true, subtree: true, characterData: true
          });
        }
        if (modal) {
          new MutationObserver(apply).observe(modal, {
            attributes: true, attributeFilter: ['style', 'class']
          });
        }
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Sticky add to cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable sticky add to cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product thumbnail",
      "default": true
    },
    {
      "type": "select",
      "id": "visible_on",
      "label": "Show on",
      "options": [
        { "value": "both", "label": "Desktop and mobile" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" }
      ],
      "default": "both"
    }
  ],
  "presets": [{ "name": "Sticky add to cart" }]
}
{% endschema %}
