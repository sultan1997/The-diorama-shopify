        "faq-2": {
          "type": "faq",
          "settings": {
            "q": "How long does a standard model take to ship?",
            "a": "Standard stock models ship within 10–14 business days from order confirmation. You'll receive a tracking number as soon as the piece leaves our Ajman workshop."
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "q": "What is included in a custom commission?",
            "a": "Every commission includes the scale model built from your technical drawings, a clear acrylic display case, an engraved black acrylic nameplate, a certificate of authenticity, one free revision round, and professional studio photography. A 50% deposit starts production."
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "q": "Can I get a model in a different scale?",
            "a": "Yes — 1:200, 1:100, 1:75, 1:50 and fully custom scales are all available. Scale affects the final model length and the level of detail achievable. We advise the best scale for your vessel type and display location during the brief."
          }
        },
        "faq-5": {
          "type": "faq",
          "settings": {
            "q": "Do you ship internationally?",
            "a": "Yes. We ship worldwide from Ajman, UAE. GCC deliveries typically arrive in 2–4 business days. International shipping to Europe, UK, Asia and North America takes 5–10 business days. Full customs documentation is included."
          }
        },
        "faq-6": {
          "type": "faq",
          "settings": {
            "q": "What if I want changes after seeing the 3D render?",
            "a": "One revision round is included at no extra cost before physical printing begins. We send a digital 3D render for your approval — only when you confirm do we start production. Additional revisions after approval are charged at a flat rate."
          }
        },
