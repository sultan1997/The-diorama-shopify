        "faq-1": {
          "type": "faq",
          "settings": {
            "q": "Will this print on a standard FDM machine?",
            "a": "Yes. At 77 x 76 x 37 mm it fits any desktop bed. The Production folder includes two pre-cut halves so you can print each one flat-face-down with no supports, then glue up a clean sphere. FDM gives a good surface; SLA resin will hold the finer crater detail."
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "q": "Is the crater detail real geometry or a texture?",
            "a": "Real geometry. The relief is modelled into the mesh across the whole surface, so it prints as physical depth rather than relying on a normal or bump map. That is why the mesh is dense, 12.6 million triangles."
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "q": "Does the pack include textures or materials?",
            "a": "No. This is an untextured mesh with no UV mapping and no material library. The surface detail is all modelled geometry, so it prints and renders on its own, but if you want a coloured render you will need to assign your own materials."
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "q": "Can I use this design for my own projects?",
            "a": "Yes. These files are licensed for your personal projects, make it for yourself, your home, a study model, or a gift. The license is for personal, non-commercial use, so it isn't intended for reselling finished units or the file pack itself."
          }
        },
        "faq-5": {
          "type": "faq",
          "settings": {
            "q": "Is there any Refund Policy?",
            "a": "We usually dont offer Refunds for Digital Files. However, if you are not satisfied with it then our designer will help you to sort things out."
          }
        },
        "rev-1": {
