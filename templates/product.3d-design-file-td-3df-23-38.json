        "faq-1": {
          "type": "faq",
          "settings": {
            "q": "Will this print on a standard desktop machine?",
            "a": "Yes. At 710 x 62 x 857 mm it fits a normal bed, and the pack includes the production files listed in the manifest. FDM gives a good surface; SLA resin holds finer detail."
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "q": "Is the detail real geometry or a texture?",
            "a": "Real geometry - the mesh carries 565,987 triangles of modelled detail."
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "q": "Does the pack include textures or materials?",
            "a": "No. This is an untextured mesh with no UV mapping and no material library, so you assign your own materials for rendering."
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "q": "Can I use this design for my own projects?",
            "a": "Licensed for personal projects only. Not for resale or commercial production. Print it, cut it, machine it, remix the source - just not for resale."
          }
        },
        "faq-5": {
          "type": "faq",
          "settings": {
            "q": "Is there any Refund Policy?",
            "a": "We usually dont offer Refunds for Digital Files. However, if you are not satisfied with it then our designer will help you to sort things out."
          }
        }
